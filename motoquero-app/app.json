{
  "expo": {
    "name": "Motoquero",
    "slug": "motoquero-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motoquero.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Motoquero necesita acceso a tu ubicación para mostrar tu posición en el mapa y rastrear viajes en tiempo real.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Motoquero necesita acceso a tu ubicación para rastrear viajes en tiempo real."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.motoquero.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Motoquero necesita acceso a tu ubicación para rastrear viajes en tiempo real."
        }
      ]
    ]
  }
}
